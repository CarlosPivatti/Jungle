{
  "name": "jungle-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:bun": "bun run src/main.ts",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:migrate:bun": "bun run src/infrastructure/database/migrate.ts",
    "test": "vitest run tests --exclude tests/integration/**",
    "test:bun": "bunx vitest run tests --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.709.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@types/pg": "^8.11.10",
    "@nestjs/testing": "^10.4.15",
    "typescript": "^5.7.0",
    "tsx": "^4.19.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
